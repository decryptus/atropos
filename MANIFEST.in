include README.md LICENSE
recursive-include examples *.yml *.yaml *.json

# Repository and maintainer material never ships in the source distribution.
prune tests
prune textual_tests
prune docs
prune scripts
prune .github
prune debian
prune docker
global-exclude __pycache__ *.py[cod]
prune client
prune client_tests
prune installed_tests
prune integration_tests
prune release_tests
prune service_tests
